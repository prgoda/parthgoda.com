ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── /network (personal CRM) ─────────────────────────────────────────────────
# Passphrase for the hidden dashboard. Leave empty to run it unlocked.
NETWORK_PASSPHRASE=
# Extra salt for the session cookie. Any long random string.
NETWORK_SECRET=

# Local SQLite file. Defaults to ./data/network.db
NETWORK_DB_PATH=
# Set these in production instead and the same code talks to Turso, which
# speaks the same SQLite dialect. When TURSO_DATABASE_URL is present it wins.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── /case-log (case interview practice log) ─────────────────────────────────
# Public to read. This 4-digit PIN is what lets you add, edit and delete.
# Empty means writing is open in dev and closed in production, so a
# misconfigured deploy is read-only rather than a public whiteboard.
CASELOG_PIN=
# Extra salt for the writer cookie. Any long random string.
CASELOG_SECRET=

# Local SQLite file. Defaults to ./data/case-log.db
CASELOG_DB_PATH=
# In production the case log reuses TURSO_DATABASE_URL above (its tables do not
# collide with /network). Set these only to give it a separate database.
CASELOG_TURSO_DATABASE_URL=
CASELOG_TURSO_AUTH_TOKEN=

# Reminder emails
NETWORK_EMAIL_TO=you@example.com
NETWORK_EMAIL_FROM=reminders@yourdomain.com
NETWORK_BASE_URL=http://localhost:3000
# Do not nag about the same person more often than this. Defaults to 7.
NETWORK_COOLDOWN_DAYS=7

# Pick one mail transport. With neither, the reminder script prints to stdout.
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
