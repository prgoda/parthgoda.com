ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── /network (personal CRM) ─────────────────────────────────────────────────
# Passphrase for the hidden dashboard. Leave empty to run it unlocked.
NETWORK_PASSPHRASE=
# Extra salt for the session cookie. Any long random string.
NETWORK_SECRET=
# Where the SQLite file lives. Defaults to ./data/network.db
NETWORK_DB_PATH=

# Reminder emails
NETWORK_EMAIL_TO=you@example.com
NETWORK_EMAIL_FROM=reminders@yourdomain.com
NETWORK_BASE_URL=http://localhost:3000
# Do not nag about the same person more often than this. Defaults to 7.
NETWORK_COOLDOWN_DAYS=7

# Pick one mail transport. With neither, the reminder script prints to stdout.
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
